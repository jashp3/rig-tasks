# Secrets and local environment - never commit
.env
.env.local
.env.*.local
.aws/
*.pem
*.key

# OpenRig runtime projections and harness output - generated, not source.
# See $OPENRIG_HOME/reference/project-workspace.md: these are ownership
# receipts and skill loadouts, and product repositories should ignore them.
.openrig/
.agents/
.claude/
.codex/
# Rig-managed culture blocks, rewritten in place by the runtime (the churn was
# pure trailing-whitespace). Regenerated locally; not product source.
AGENTS.md
CLAUDE.md

# Dependencies and build output
node_modules/
.npm-cache/
.next/
dist/
build/

# Local database
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# OS / editor noise
.DS_Store
*.log
